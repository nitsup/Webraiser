---
import PageShell from '../layouts/PageShell.astro';
import { processSteps, services } from '../data/siteContent';
---

<PageShell
	title="Website Development Services — WebRaiser"
	description="WebRaiser offers custom business, e-commerce, portfolio, landing-page and web application development, plus website redesigns for modern businesses."
>
	<section class="page-intro shell" aria-labelledby="page-title">
		<p class="eyebrow">What we do</p>
		<h1 id="page-title">The right website<br />for <em>your next move.</em></h1>
		<p>WebRaiser works with modern businesses in India and internationally. Services range from business and e-commerce websites to portfolio sites, landing pages, web applications and redesigns.</p>
	</section>

	<section class="section shell service-approach" aria-labelledby="service-approach-title">
		<div>
			<p class="eyebrow">Custom development</p>
			<h2 id="service-approach-title">What does custom website development mean?</h2>
		</div>
		<div class="service-approach-copy">
			<p>Custom website development begins with your business, audience and project requirements. The site structure and experience are shaped around that brief rather than starting from a ready-made template.</p>
			<p>A template is a pre-designed starting point that can be adapted. WebRaiser’s template previews are concepts and are not currently available as products. The right approach depends on the scope and needs of your project.</p>
			<a class="text-link" href="/templates">See the template concepts <span aria-hidden="true">↗</span></a>
		</div>
	</section>

	<section class="services-section page-services-section" aria-label="Web development services">
		<div class="shell section">
			<div class="services-grid page-services-grid">
				{services.map((service) => (
					<article class="service-card">
						<span class="service-number">{service.number}</span>
						<div>
							<h3>{service.title}</h3>
							<p>{service.description}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section shell page-process-section" aria-labelledby="process-title">
		<div class="section-heading">
			<div>
				<p class="eyebrow">A clear process</p>
				<h2 id="process-title">Thoughtful at<br /><em>every step.</em></h2>
			</div>
			<p class="section-intro">Each project starts with understanding the need and agreeing the scope before work moves ahead.</p>
		</div>
		<ol class="process-list">
			{processSteps.map((step) => (
				<li class="process-step">
					<span class="process-number">{step.number}</span>
					<h3>{step.title}</h3>
					<p>{step.description}</p>
				</li>
			))}
		</ol>
	</section>

	<section class="page-bottom-cta">
		<div class="shell page-bottom-cta-inner">
			<div>
				<p class="eyebrow eyebrow-light">Start with a conversation</p>
				<h2>Tell us what<br /><em>you have in mind.</em></h2>
			</div>
			<a class="button button-light" href="/contact">Discuss a project <span aria-hidden="true">↗</span></a>
		</div>
	</section>
</PageShell>
