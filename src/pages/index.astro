---
import WebsitePreview from '../components/WebsitePreview.astro';
import PageShell from '../layouts/PageShell.astro';
import { projects, services, templates } from '../data/siteContent';
---

<PageShell
	title="WebRaiser — Thoughtful websites for ambitious businesses"
	description="WebRaiser builds exceptional digital experiences for modern businesses, from bespoke websites to ready-made template concepts."
>
	<section class="hero shell" aria-labelledby="hero-title">
		<div class="hero-copy">
			<p class="eyebrow"><span class="eyebrow-mark"></span> Web development studio · India & worldwide</p>
			<h1 id="hero-title">A better web<br />for <em>what’s next.</em></h1>
			<p class="hero-description">
				WebRaiser builds exceptional digital experiences for modern businesses — from
				bespoke websites to ready-made templates.
			</p>
			<div class="hero-actions">
				<a class="button button-dark" href="/contact">
					Start a project
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 3l5 5-5 5" /></svg>
				</a>
				<a class="text-link" href="/work">Explore our work <span aria-hidden="true">↗</span></a>
			</div>
		</div>
		<div class="hero-visual">
			<div class="hero-visual-label"><span>A glimpse of what we can make</span><span>Illustrative preview</span></div>
			<WebsitePreview variant="hero" />
			<div class="hero-visual-caption"><span>Thoughtful by design</span><span>Responsive by default</span></div>
		</div>
	</section>

	<section class="section shell home-preview-section" aria-labelledby="home-work-title">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Selected work</p>
				<h2 id="home-work-title">Good work, <em>well presented.</em></h2>
			</div>
			<a class="text-link" href="/work">See all work <span aria-hidden="true">↗</span></a>
		</div>
		<div class="work-grid home-work-grid">
			{projects.slice(0, 2).map((project) => (
				<a class="work-card home-work-card" href="/work">
					<div class="work-preview-wrap">
						<span class="preview-badge">Concept preview</span>
						<WebsitePreview variant={project.variant} />
					</div>
					<div class="work-card-copy">
						<div>
							<p class="card-category">{project.category}</p>
							<h3>{project.title}</h3>
						</div>
						<span class="card-link-arrow" aria-hidden="true">↗</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="services-section home-services-section" aria-labelledby="home-services-title">
		<div class="shell section">
			<div class="section-heading">
				<div>
					<p class="eyebrow eyebrow-light">What we do</p>
					<h2 id="home-services-title">The right website<br />for <em>your next move.</em></h2>
				</div>
				<div class="section-intro-wrap">
					<p class="section-intro">From business websites to custom digital experiences, we make the web work harder for your business.</p>
					<a class="text-link text-link-light" href="/services">Explore services <span aria-hidden="true">↗</span></a>
				</div>
			</div>
			<div class="services-grid home-services-grid">
				{services.slice(0, 3).map((service) => (
					<a class="service-card" href="/services">
						<span class="service-number">{service.number}</span>
						<div>
							<h3>{service.title}</h3>
							<p>{service.description}</p>
						</div>
						<span class="service-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="templates-section home-templates-section" aria-labelledby="home-templates-title">
		<div class="shell section">
			<div class="templates-heading">
				<div>
					<p class="eyebrow">Template concepts</p>
					<h2 id="home-templates-title">A thoughtful start.<br /><em>Room to make it yours.</em></h2>
				</div>
				<div class="templates-intro">
					<p>Preview directions for a more considered way to get online. These concepts are not currently for sale.</p>
					<a class="button button-outline" href="/templates">
						Explore templates
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 3l5 5-5 5" /></svg>
					</a>
				</div>
			</div>
			<div class="template-grid home-template-grid">
				{templates.slice(0, 2).map((template) => (
					<a class="template-card" href="/templates">
						<div class="template-art-wrap">
							<WebsitePreview variant={template.variant} />
							<span class="template-index">DIRECTION / {template.number}</span>
						</div>
						<div class="template-card-copy">
							<div>
								<p class="card-category">Preview concept · Not for sale</p>
								<h3>{template.name}</h3>
							</div>
							<span class="template-arrow" aria-hidden="true">↗</span>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="home-cta-section">
		<div class="shell home-cta-inner">
			<div>
				<p class="eyebrow eyebrow-light">Your next chapter</p>
				<h2>Have something<br /><em>good in mind?</em></h2>
			</div>
			<div class="home-cta-copy">
				<p>Tell us what you’re building and what a better website could help you do.</p>
				<a class="button button-light" href="/contact">
					Start a project
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 3l5 5-5 5" /></svg>
				</a>
			</div>
		</div>
	</section>
</PageShell>
