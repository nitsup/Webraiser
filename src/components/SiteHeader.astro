---
const links = [
	{ label: 'Home', href: '/' },
	{ label: 'Work', href: '/work' },
	{ label: 'Services', href: '/services' },
	{ label: 'Templates', href: '/templates' },
	{ label: 'About', href: '/about' },
	{ label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href="/" aria-label="WebRaiser home">
			<img class="brand-logo" src="/webraiser-logo.svg" alt="WebRaiser" width="480" height="120" />
		</a>

		<nav class="desktop-nav" aria-label="Main navigation">
			{links.map((link) => (
				<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
			))}
		</nav>

		<a class="button button-dark header-cta" href="/contact">
			Start a project
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 3l5 5-5 5" /></svg>
		</a>

		<details class="mobile-menu">
			<summary aria-label="Toggle site navigation">
				<span></span><span></span>
			</summary>
			<nav class="mobile-nav" aria-label="Mobile navigation">
				{links.map((link) => (
					<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
				))}
				<a class="mobile-nav-cta" href="/contact">Start a project <span aria-hidden="true">↗</span></a>
			</nav>
		</details>
	</div>
</header>

<script>
	const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');

	mobileMenu?.querySelectorAll('a[href^="/"]').forEach((link) => {
		link.addEventListener('click', () => {
			mobileMenu.open = false;
		});
	});
</script>
