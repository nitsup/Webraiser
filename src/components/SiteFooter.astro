---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell">
		<div class="footer-main">
			<div class="footer-brand-block">
				<a class="brand brand-footer" href="/" aria-label="WebRaiser home">
					<svg class="brand-mark" viewBox="0 0 36 36" aria-hidden="true">
						<path d="M4 9.5h5.1l3.3 13 3.6-10.2h4.2l3.6 10.2 3.3-13H32l-5.8 19h-5.4L18 19.2l-2.8 9.3H9.8L4 9.5Z" fill="currentColor" />
					</svg>
					<span>webraiser<span class="brand-period">.</span></span>
				</a>
				<p>Thoughtful websites and useful digital products for what comes next.</p>
			</div>

			<div class="footer-links">
				<div>
					<p class="footer-label">Explore</p>
					<a href="/work">Work</a>
					<a href="/services">Services</a>
					<a href="/templates">Templates</a>
					<a href="/about">About</a>
				</div>
				<div>
					<p class="footer-label">Start here</p>
					<a href="/contact">Start a project</a>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p>© {year} WebRaiser. All rights reserved.</p>
			<a href="#main" class="back-to-top">Back to top <span aria-hidden="true">↑</span></a>
		</div>
	</div>
</footer>
